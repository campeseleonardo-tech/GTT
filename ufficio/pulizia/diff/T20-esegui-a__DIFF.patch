+/** Funzioni per i debiti di ripasso. */
+function caricaDebiti(storage) {
+  if (!storage) return { articoli:[], frasi:[], errori:[] };
+  try {
+    const testo = storage.getItem(CHIAVE_DEBITI);
+    return testo ? JSON.parse(testo) : { articoli:[], frasi:[], errori:[] };
+  } catch (e) {
+    return { articoli:[], frasi:[], errori:[] };
+  }
+}
+function salvaDebiti(storage, debito) {
+  if (!storage) return false;
+  try {
+    storage.setItem(CHIAVE_DEBITI, JSON.stringify(debito));
+    return true;
+  } catch (e) {
+    return false;
+  }
+}
+/** Aggiunge un debito per il gioco e l'id specificati. */
+function aggiungiDebito(gioco, id) {
+  if (!debito) return;
+  const arr = debito[gioco];
+  let trovato = arr.find(item => item.id === id);
+  if (trovato) {
+    trovato.volte += 1;
+  } else {
+    if (arr.length >= 50) {
+      // rimuovi quello con meno volte (più vecchio)
+      let minIdx = 0;
+      for (let i = 1; i < arr.length; i++) {
+        if (arr[i].volte < arr[minIdx].volte) minIdx = i;
+      }
+      arr.splice(minIdx, 1);
+    }
+    arr.push({id: id, volte: 1});
+  }
+  salvaDebiti(storage, debito);
+  aggiornaHome(); // aggiorna il contatore in home
+}
+/** Rimuove un debito (quando l'utente risponde correttamente nel ripasso). */
+function rimuoviDebito(gioco, id) {
+  if (!debito) return;
+  const arr = debito[gioco];
+  const idx = arr.findIndex(item => item.id === id);
+  if (idx !== -1) {
+    arr.splice(idx, 1);
+    salvaDebiti(storage, debito);
+    aggiornaHome();
+  }
+}
+/** Restituisce i debiti per un gioco, ordinati per volte decrescente, max 50. */
+function getDebitiPerGioco(gioco) {
+  const list = debito[gioco] || [];
+  const copia = list.slice().sort((a, b) => b.volte - a.volte);
+  return copia.slice(0, 50);
+}
