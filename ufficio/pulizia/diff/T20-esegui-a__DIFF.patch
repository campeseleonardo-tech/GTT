+        if (corrente.scelti.indexOf(i) === -1) {
+          rimasti.appendChild(bottone(rec.blocchi[i], 'blocco', function () { mettiBlocco(i); },
+            { lang: 'de', 'data-i': String(i) }));
+        }
+      });
+      sessione.corpo.appendChild(rimasti);
+      // azioni
+      const azioni = el('div', { classe: 'azioni' });
+      const controlla = bottone('Controlla', 'primario', controllaClickFrase, { id: 'btn-controlla' });
+      azioni.appendChild(controlla);
+      azioni.appendChild(bottone('Ricomincia', '', function () { corrente.scelti = []; sessione.messaggio('info', []); disegnaFrase(); }));
+      azioni.appendChild(bottone('Mostra la soluzione', '', mostraSoluzioneFrase));
+      sessione.corpo.appendChild(azioni);
+      disegnaFrase();
+    }
+
+    function mostraErrore(id) {
+      const rec = window.LANGUE_DATA.errori.find(r => r.id === id);
+      corrente.record = rec;
+      const opzioni = opzioniErrore(rec);
+      sessione.corpo.appendChild(el('p', { classe: 'istruzione', testo: 'Quale frase è scritta correttamente?' }));
+      const gruppo = el('div', { classe: 'due-opzioni', attr: { role: 'group', 'aria-label': 'Le due frasi' } });
+      opzioni.forEach(function (op) {
+        const b = bottone(op.testo, 'opzione', function () { rispondiErrore(op); }, { lang: 'de' });
+        b._corretta = op.corretta;
+        gruppo.appendChild(b);
+      });
+      sessione.corpo.appendChild(gruppo);
+      gruppo.firstChild.focus();
+    }
+
+    function disegnaFrase() {
+      // ricostruisce la vista frase (costruita e rimasti)
+      svuota(sessione.corpo);
+      // rifacciamo mostraFrase senza ricostruire tutto? più semplice richiamare mostraFrase di nuovo
+      mostraFrase(corrente.record.id);
+    }
+
+    function rispondiArticolo(scelto, rec) {
+      const giusta = (scelto === rec.articolo);
+      // disabilita bottoni
+      sessione.corpo.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
+      // evidenzia
+      sessione.corpo.querySelectorAll('button').forEach(function (b) {
+        if (b.textContent === rec.articolo) {
+          b.classList.add('giusto');
+          b.textContent = '✓ ' + b.textContent;
+        } else if (b.textContent === scelto) {
+          b.classList.add('sbagliato');
+          b.textContent = '✗ ' + b.textContent;
+        }
+      });
+      sessione.registra(giusta);
+      if (giusta) {
+        rimuoviDebito('articoli', rec.id);
+        // rimuovi anche da tuttiDebiti
+        const idx = tuttiDebiti.findIndex(d => d.gioco === 'articoli' && d.id === rec.id);
+        if (idx !== -1) tuttiDebiti.splice(idx, 1);
+      }
+      sessione.messaggio(giusta ? 'ok' : 'ko', [
+        { testo: giusta ? 'Giusto!' : 'Non proprio.', classe: 'esito' },
+        { testo: rec.articolo + ' ' + rec.parola, lingua: 'de', classe: 'de-grande' },
+        { testo: 'In italiano: ' + rec.traduzione_it }
+      ]);
+      sessione.mostraAvanti();
+    }
+
+    function mettiBlocco(i) {
+      if (corrente.scelti.length >= corrente.record.blocchi.length) return;
+      corrente.scelti.push(i);
+      const prossimo = corrente.ordine.find(function (k) { return corrente.scelti.indexOf(k) === -1; });
+      disegnaFrase(prossimo === undefined ? 'controlla' : prossimo);
+    }
+
+    function togliBlocco(i) {
+      corrente.scelti = corrente.scelti.filter(function (k) { return k !== i; });
+      disegnaFrase(i);
+    }
+
+    function controllaClickFrase() {
+      if (corrente.scelti.length < corrente.record.blocchi.length) {
+        sessione.messaggio('info', [{ testo: 'Usa tutti i blocchi prima di controllare.' }]);
+        return;
+      }
+      const testi = corrente.scelti.map(function (i) { return corrente.record.blocchi[i]; });
+      if (controllaOrdine(testi, corrente.record)) {
+        sessione.registra(true);
+        rimuoviDebito('frasi', corrente.record.id);
+        const idx = tuttiDebiti.findIndex(d => d.gioco === 'frasi' && d.id === corrente.record.id);
+        if (idx !== -1) tuttiDebiti.splice(idx, 1);
+        sessione.messaggio('ok', [
+          { testo: 'Giusto!', classe: 'esito' },
+          { testo: testi.join(' '), lingua: 'de', classe: 'de-grande' },
+          { testo: corrente.traduzione_it }
+        ]);
+        disegnaFrase(null);
+        sessione.mostraAvanti();
+      } else {
+        sessione.registra(false);
+        sessione.messaggio('ko', [{ testo: 'Non è ancora giusto: riprova, oppure guarda la soluzione.', classe: 'esito' }]);
+      }
+    }
+
+    function mostraSoluzioneFrase() {
+      sessione.registra(false);
+      // nessun debito aggiunto perché mostra soluzione conta come errore già gestito altrove? Aggiungiamo debito.
+      aggiungiDebito('frasi', corrente.record.id);
+      const idx = tuttiDebiti.findIndex(d => d.gioco === 'frasi' && d.id === corrente.record.id);
+      if (idx === -1) tuttiDebiti.push({ gioco: 'frasi', id: corrente.record.id, volte: 1 });
+      sessione.messaggio('info', [
+        { testo: 'Una soluzione possibile:' },
+        { testo: corrente.testo_de, lingua: 'de', classe: 'de-grande' },
+        { testo: corrente.traduzione_it }
+      ]);
+      disegnaFrase(null);
+      sessione.mostraAvanti();
+    }
+
+    function rispondiErrore(op) {
+      // disabilita bottoni
+      sessione.corpo.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
+      // evidenzia
+      sessione.corpo.querySelectorAll('button').forEach(function (b) {
+        if (b._corretta) {
+          b.classList.add('giusto');
+          b.textContent = '✓ ' + b.textContent;
+        } else if (b.textContent === op.testo) {
+          b.classList.add('sbagliato');
+          b.textContent = '✗ ' + b.textContent;
+        }
+      });
+      const giusta = op.corretta;
+      sessione.registra(giusta);
+      if (!giusta) {
+        aggiungiDebito('errori', corrente.record.id);
+        const idx = tuttiDebiti.findIndex(d => d.gioco === 'errori' && d.id === corrente.record.id);
+        if (idx === -1) tuttiDebiti.push({ gioco: 'errori', id: corrente.record.id, volte: 1 });
+      }
+      sessione.messaggio(giusta ? 'ok' : 'ko', [
+        { testo: giusta ? 'Giusto!' : 'Non proprio.', classe: 'esito' },
+        { testo: 'Frase corretta: ' + corrente.record.frase_corretta, lingua: 'de', classe: 'de-grande' },
+        { testo: corrente.record.spiegazione_it }
+      ]);
+      sessione.mostraAvanti();
+    }
+
+    function creaSessioneGenerale() {
+      const sessione = { serie: 0 };
+      const barra = el('p', { classe: 'barra-serie' });
+      const corpo = el('div', { classe: 'corpo' });
+      const messaggio = el('div', { classe: 'messaggio', attr: { role: 'status', 'aria-live': 'polite' } });
+      const avanti = bottone('Avanti →', 'primario', alProssimoGenerale);
+      avanti.hidden = true;
+      const azioni = el('div', { classe: 'azioni' }, [avanti]);
+      area.appendChild(barra);
+      area.appendChild(corpo);
+      area.appendChild(messaggio);
+      area.appendChild(azioni);
+
+      function aggiornaBarra() {
+        // non abbiamo serie per gioco specifico, mostriamo totale debito rimanente
+        const rimanenti = tuttiDebiti.length;
+        barra.textContent = 'Debiti rimanenti: ' + rimanenti;
+      }
+      aggiornaBarra();
+
+      sessione.corpo = corpo;
+      sessione.azioni = azioni;
+      sessione.avanti = avanti;
+
+      sessione.nuovaDomanda = function () {
+        svuota(messaggio);
+        messaggio.className = 'messaggio';
+        avanti.hidden = true;
+      };
+
+      sessione.registra = function (giusta) {
+        sessione.serie = giusta ? sessione.serie + 1 : 0;
+        salva();
+        aggiornaBarra();
+      };
+
+      sessione.messaggio = function (tipo, righe) {
+        svuota(messaggio);
+        messaggio.className = 'messaggio ' + tipo;
+        righe.forEach(function (r) {
+          messaggio.appendChild(el('p', { testo: r.testo, lingua: r.lingua, classe: r.classe }));
+        });
+      };
+
+      sessione.mostraAvanti = function () {
+        avanti.hidden = false;
+        avanti.focus();
+      };
+
+      function alProssimoGenerale() {
+        if (tuttiDebiti.length === 0) {
+          mostraGioco('Ripasso completato');
+          svuota(area);
+          area.appendChild(el('p', { classe: 'messaggio info', testo: 'Hai ripassato tutti i debiti!' }));
+          setTimeout(mostraHome, 1500);
+        } else {
+          prossima();
+        }
+      }
+
+      return sessione;
+    }
+
+    prossima();
+  }
 }
