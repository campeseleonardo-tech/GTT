+# origine: agente TL02-router
+# stato: bozza
+"""
+Table routing module for Personal Data Vault.
+
+Provides:
+- KeywordBackend: pure Python word-overlap/TF-IDF on table name+description
+- EmbeddingBackend stub: raises NotImplementedError (requires Ollama)
+- LocalLLMBackend stub: raises NotImplementedError (requires Ollama)
+- route(question, tables, backend, k): returns ranked list of (table_name, score)
+- evaluate(backend, cases, tables, k): computes top1, top3, recall@k
+- shuffle_tables_evaluate(backend, cases, tables, k, n_shuffles): tests robustness to table order
+- Self-test with synthetic data under __main__
+"""
+
+from __future__ import annotations
+
+import math
+import random
+import re
+from typing import Dict, List, Tuple, Any
+
+
+class Backend:
+    """Base class for table ranking backends."""
+    def rank(self, question: str, tables: List[Dict[str, str]]) -> List[Tuple[str, float]]:
+        raise NotImplementedError
+
+
+class KeywordBackend(Backend):
+    """
+    Pure Python word-overlap/TF-IDF on table name+description.
+    - Tokenizes by splitting on non-alphanumeric (keeps underscores as part of words).
+    - Uses TF-IDF: term frequency in table text * inverse document frequency across tables.
+    - Score = sum of TF-IDF weights for query terms present in table text.
+    """
+
+    def __init__(self) -> None:
+        self._stopwords = {
+            "il", "lo", "la", "i", "gli", "le", "un", "uno", "una", "di", "a", "da", "in",
+            "con", "su", "per", "tra", "fra", "e", "o", "ma", "se", "che", "cui", "non",
+            "mi", "ti", "si", "ci", "vi", "al", "del", "dello", "della", "dei", "degli",
+            "delle", "agl", "allo", "alla", "ai", "agli", "alle", "dal", "dallo", "dalla",
+            "dai", "dagli", "dalle", "col", "collo", "colla", "coi", "cogli", "colle",
+            "sul", "sullo", "sulla", "sui", "sugli", "sulle", "il", "lo", "la", "i", "gli",
+            "le", "un", "uno", "una", "di", "a", "da", "in", "con", "su", "per", "tra",
+            "fra", "e", "o", "ma", "se", "che", "cui", "non"
+        }
+
+    def _tokenize(self, text: str) -> List[str]:
+        # Simple tokenization: lowercase, split on non-alnum, keep words with at least 2 chars
+        tokens = re.findall(r"[a-zA-Z0-9_]+", text.lower())
+        return [t for t in tokens if t not in self._stopwords and len(t) >= 2]
+
+    def rank(self, question: str, tables: List[Dict[str, str]]) -> List[Tuple[str, float]]:
+        # Preprocess question
+        q_tokens = self._tokenize(question)
+        if not q_tokens:
+            return [(t["name"], 0.0) for t in tables]
+
+        # Build vocabulary from all table texts (name + description)
+        table_texts = []
+        for t in tables:
+            text = f"{t['name']} {t.get('description', '')}"
+            table_texts.append(self._tokenize(text))
+
+        # Compute document frequency (DF) for each token in tables
+        df: Dict[str, int] = {}
+        for tokens in table_texts:
+            seen = set(tokens)
+            for token in seen:
+                df[token] = df.get(token, 0) + 1
+
+        num_tables = len(tables)
+        # Avoid division by zero: if df=0 (shouldn't happen) treat as 1
+        idf: Dict[str, float] = {
+            token: math.log(num_tables / (df.get(token, 1) + 1)) for token in set(q_tokens)
+        }
+
+        # Score each table: sum of (TF in table * IDF) for query tokens
+        scores: List[float] = []
+        for tokens in table_texts:
+            tf: Dict[str, int] = {}
+            for token in tokens:
+                tf[token] = tf.get(token, 0) + 1
+            score = 0.0
+            for token in q_tokens:
+                if token in tf:
+                    # TF = raw count (could normalize, but raw is fine for ranking)
+                    score += tf[token] * idf.get(token, 0.0)
+            scores.append(score)
+
+        # Return sorted by score descending
+        ranked = sorted(zip([t["name"] for t in tables], scores), key=lambda x: x[1], reverse=True)
+        return ranked
+
+
