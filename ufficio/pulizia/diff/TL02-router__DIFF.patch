+            "Implement by prompting the LLM to rank tables by relevance to the question."
+        )
+
+
+def route(
+    question: str,
+    tables: List[Dict[str, str]],
+    backend: Backend = KeywordBackend(),
+    k: int = 3,
+) -> List[Tuple[str, float]]:
+    """
+    Rank tables by relevance to question using given backend.
+    Returns list of (table_name, score) sorted descending, truncated to k.
+    """
+    ranked = backend.rank(question, tables)
+    return ranked[:k]
+
+
+def evaluate(
+    backend: Backend,
+    cases: List[Dict[str, Any]],
+    tables: List[Dict[str, str]],
+    k: int = 3,
+) -> Dict[str, float]:
+    """
+    Compute evaluation metrics:
+    - top1: fraction of cases where the first needed table is in position 0
+    - top3: fraction of cases where all needed tables are in top k
+    - recall_at_k: fraction of needed tables recovered in top k (averaged over cases)
+    """
+    top1_hits = 0
+    top3_hits = 0
+    recall_sum = 0.0
+    total_needed = 0
+
+    for case in cases:
+        needed = set(case["needed_tables"])
+        ranked = route(case["question"], tables, backend, k=len(tables))  # full ranking
+        top_k_names = [name for name, _ in ranked[:k]]
+
+        # top1: if needed set non-empty, check if highest ranked is in needed
+        if needed:
+            if ranked[0][0] in needed:
+                top1_hits += 1
+
+        # top3: all needed tables in top k?
+        if needed.issubset(set(top_k_names)):
+            top3_hits += 1
+
+        # recall_at_k: |needed ∩ top_k| / |needed|
+        hit = len(needed.intersection(set(top_k_names)))
+        recall_sum += hit / len(needed) if needed else 0.0
+        total_needed += len(needed)
+
+    n_cases = len(cases)
+    return {
+        "top1": top1_hits / n_cases if n_cases else 0.0,
+        "top3": top3_hits / n_cases if n_cases else 0.0,
+        "recall_at_k": recall_sum / n_cases if n_cases else 0.0,
+    }
+
+
+def shuffle_tables_evaluate(
+    backend: Backend,
+    cases: List[Dict[str, Any]],
+    tables: List[Dict[str, str]],
+    k: int = 3,
+    n_shuffles: int = 100,
+) -> Dict[str, float]:
+    """
+    Evaluate robustness to table order by shuffling table list n_shuffles times
+    (fixed seed per shuffle for reproducibility) and reporting metric variation.
+    Returns dict with mean and std of top1, top3, recall_at_k across shuffles.
+    """
+    random.seed(42)  # fixed seed for reproducibility
+    metrics_list = []
+
+    for _ in range(n_shuffles):
+        shuffled = tables.copy()
+        random.shuffle(shuffled)
+        metrics = evaluate(backend, cases, shuffled, k)
+        metrics_list.append(metrics)
+
+    # Compute mean and std for each metric
+    keys = metrics_list[0].keys() if metrics_list else []
+    result: Dict[str, float] = {}
+    for key in keys:
+        values = [m[key] for m in metrics_list]
+        mean = sum(values) / len(values)
+        variance = sum((x - mean) ** 2 for x in values) / len(values)
+        std = math.sqrt(variance)
+        result[f"{key}_mean"] = mean
+        result[f"{key}_std"] = std
+
+    return result
+
