+/* [agente T20-esegui-a] ---- Ripasso degli sbagli: funzioni pure per la lista dei "debiti" ----
+   Un debito = un record su cui l'utente ha sbagliato (o ha rinunciato), con il numero di volte.
+   Forma: { versione: 1, giochi: { articoli: [{id, volte}], frasi: [...], errori: [...] } }
+   In ogni lista l'ultimo elemento e' il piu' recente; al massimo MAX_DEBITI per gioco (i piu' vecchi si scartano). */
+
+const MAX_DEBITI = 50;
+
+/** Debiti vuoti. */
+function nuoviDebiti() {
+  const giochi = {};
+  GIOCHI.forEach(function (g) { giochi[g] = []; });
+  return { versione: 1, giochi: giochi };
+}
+
+/** Costruisce debiti validi partendo da un oggetto qualsiasi (letto dal browser). */
+function sistemaDebiti(grezzo) {
+  const d = nuoviDebiti();
+  if (!grezzo || typeof grezzo !== 'object' || !grezzo.giochi || typeof grezzo.giochi !== 'object') return d;
+  GIOCHI.forEach(function (nome) {
+    const lista = Array.isArray(grezzo.giochi[nome]) ? grezzo.giochi[nome] : [];
+    const visti = Object.create(null);
+    lista.forEach(function (v) {
+      if (!v || typeof v.id !== 'string' || v.id === '' || visti[v.id]) return;
+      visti[v.id] = true;
+      d.giochi[nome].push({ id: v.id, volte: Math.max(1, interoSicuro(v.volte)) });
+    });
+    if (d.giochi[nome].length > MAX_DEBITI) d.giochi[nome] = d.giochi[nome].slice(-MAX_DEBITI);
+  });
+  return d;
+}
+
+/** Aggiunge un errore (o aumenta di 1 le volte se c'e' gia'; torna "recente"). Modifica e restituisce `debiti`. */
+function aggiungiDebito(debiti, gioco, id) {
+  const lista = debiti && debiti.giochi ? debiti.giochi[gioco] : null;
+  if (!lista || typeof id !== 'string' || id === '') return debiti;
+  let volte = 1;
+  const pos = lista.findIndex(function (d) { return d.id === id; });
+  if (pos !== -1) {
+    volte = lista[pos].volte + 1;
+    lista.splice(pos, 1);
+  }
+  lista.push({ id: id, volte: volte });
+  while (lista.length > MAX_DEBITI) lista.shift();
+  return debiti;
+}
+
+/** Toglie un errore dalla lista (risposta giusta nel ripasso). Modifica e restituisce `debiti`. */
+function rimuoviDebito(debiti, gioco, id) {
+  const lista = debiti && debiti.giochi ? debiti.giochi[gioco] : null;
+  if (!lista) return debiti;
+  debiti.giochi[gioco] = lista.filter(function (d) { return d.id !== id; });
+  return debiti;
+}
+
+/** Lista [{id, volte}] di un gioco: prima chi e' stato sbagliato piu' volte, a parita' il piu' recente. */
+function getDebitiPerGioco(debiti, gioco) {
+  const lista = (debiti && debiti.giochi && debiti.giochi[gioco]) || [];
+  return lista
+    .map(function (d, i) { return { id: d.id, volte: d.volte, pos: i }; })
+    .sort(function (a, b) { return (b.volte - a.volte) || (b.pos - a.pos); })
+    .map(function (d) { return { id: d.id, volte: d.volte }; });
