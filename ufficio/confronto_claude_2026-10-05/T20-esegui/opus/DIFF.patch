+/* [agente T20-esegui-a] Ripasso degli sbagli ("debiti").
+   Per ogni gioco: lista di {id, volte, ultima}. id = id del record sbagliato,
+   volte = quante volte e' stato sbagliato, ultima = momento dell'ultimo errore (numero).
+   Si tengono al massimo MAX_DEBITI voci per gioco: oltre il limite si scarta la piu' vecchia. */
+const MAX_DEBITI = 50;
+
+/** [agente T20-esegui-a] Debiti vuoti. */
+function nuoviDebiti() {
+  const giochi = {};
+  GIOCHI.forEach(function (g) { giochi[g] = []; });
+  return { versione: 1, giochi: giochi };
+}
+
+/** [agente T20-esegui-a] Toglie le voci piu' vecchie (ultima piu' bassa) finche' si sta nel limite. Lavora su una copia. */
+function tagliaDebiti(lista) {
+  const copia = lista.slice();
+  while (copia.length > MAX_DEBITI) {
+    let piuVecchia = 0;
+    for (let i = 1; i < copia.length; i++) {
+      if (copia[i].ultima < copia[piuVecchia].ultima) piuVecchia = i;
+    }
+    copia.splice(piuVecchia, 1);
+  }
+  return copia;
+}
+
+/** [agente T20-esegui-a] Costruisce debiti validi partendo da un oggetto qualsiasi (letto dal browser). */
+function sistemaDebiti(grezzo) {
+  const d = nuoviDebiti();
+  if (!grezzo || typeof grezzo !== 'object') return d;
+  const g = grezzo.giochi && typeof grezzo.giochi === 'object' ? grezzo.giochi : {};
+  GIOCHI.forEach(function (nome) {
+    const lista = Array.isArray(g[nome]) ? g[nome] : [];
+    const visti = Object.create(null);
+    lista.forEach(function (v) {
+      if (!v || typeof v !== 'object' || typeof v.id !== 'string' || v.id === '' || visti[v.id]) return;
+      visti[v.id] = true;
+      d.giochi[nome].push({ id: v.id, volte: Math.max(1, interoSicuro(v.volte)), ultima: interoSicuro(v.ultima) });
+    });
+    d.giochi[nome] = tagliaDebiti(d.giochi[nome]);
+  });
+  return d;
+}
+
+/** [agente T20-esegui-a] Segna un errore: +1 se l'item c'e' gia', altrimenti lo aggiunge (con limite). */
+function aggiungiDebitoA(debiti, gioco, id, ora) {
+  if (!debiti.giochi[gioco] || typeof id !== 'string' || id === '') return debiti;
+  const t = interoSicuro(ora);
+  const lista = debiti.giochi[gioco];
+  const voce = lista.find(function (x) { return x.id === id; });
+  if (voce) {
+    voce.volte += 1;
+    voce.ultima = t;
+  } else {
+    lista.push({ id: id, volte: 1, ultima: t });
+    debiti.giochi[gioco] = tagliaDebiti(lista);
+  }
+  return debiti;
+}
+
+/** [agente T20-esegui-a] Toglie un item dai debiti di un gioco. */
+function rimuoviDebitoDa(debiti, gioco, id) {
+  if (!debiti.giochi[gioco]) return debiti;
+  debiti.giochi[gioco] = debiti.giochi[gioco].filter(function (x) { return x.id !== id; });
+  return debiti;
+}
+
+/** [agente T20-esegui-a] Debiti di un gioco come [{id, volte}], i piu' sbagliati prima (a parita': il piu' recente), max 50. */
+function elencoDebiti(debiti, gioco) {
+  return (debiti.giochi[gioco] || []).slice()
+    .sort(function (a, b) { return (b.volte - a.volte) || (b.ultima - a.ultima); })
+    .slice(0, MAX_DEBITI)
+    .map(function (x) { return { id: x.id, volte: x.volte }; });
+}
