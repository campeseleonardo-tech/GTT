+# origine: agente TL04-test-v2
+# stato: bozza
+"""
+Unit tests (unittest) per code/table_router.py e code/privacy_policy.py.
+
+Vincoli rispettati:
+- niente rete, niente Ollama, niente database: tutto gira su dati sintetici
+  in memoria e solo standard library Python.
+- i due moduli sotto test sono importati dalla stessa directory di questo
+  file, sia che il test venga caricato come `code.test_table_router_policy`
+  (con `python -m unittest code/test_table_router_policy.py`), sia che venga
+  eseguito direttamente (`python code/test_table_router_policy.py`).
+
+Come far girare:
+    python -m unittest code/test_table_router_policy.py
+"""
+
+from __future__ import annotations
+
+import os
+import random
+import sys
+import unittest
+
+# Rendi importabile la directory che contiene table_router.py /
+# privacy_policy.py, indipendentemente da come questo modulo viene caricato.
+_CODE_DIR = os.path.dirname(os.path.abspath(__file__))
+if _CODE_DIR not in sys.path:
+    sys.path.insert(0, _CODE_DIR)
+
+import table_router
+import privacy_policy
+
+
+# Set di tabelle sintetico e autocontenuto (niente dati personali reali).
+SYNTHETIC_TABLES = [
+    {"name": "spotify_plays", "description": "ascolti musicali: brano, artista, album, durata, playlist"},
+    {"name": "money_transactions", "description": "movimenti bancari: data, importo, causale, conto, categoria"},
+    {"name": "chess_games", "description": "partite a scacchi: apertura, risultato, avversario"},
+    {"name": "whatsapp_messages", "description": "messaggi di chat: mittente, destinatario, testo, allegati"},
+]
+
+# Domande scelte per condividere keyword distinte con la name+description di
+# UNA sola tabella (KeywordBackend non fa stemming: le keyword usate sono i
+# token esatti presenti nel testo della tabella target).
+Q_SPOTIFY = "Quale brano e artista ho ascoltato?"
+Q_CHESS = "Quale apertura ho usato e qual è il risultato?"
+
+
+class TableRouterTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.backend = table_router.KeywordBackend()
+
+    def test_route_returns_k_results(self) -> None:
+        ranked3 = table_router.route(Q_SPOTIFY, SYNTHETIC_TABLES, self.backend, k=3)
+        self.assertEqual(len(ranked3), 3)
+
+        ranked1 = table_router.route(Q_SPOTIFY, SYNTHETIC_TABLES, self.backend, k=1)
+        self.assertEqual(len(ranked1), 1)
+
+        # k maggiore del numero di tabelle -> restituisce tutte quelle disponibili
+        ranked_big = table_router.route(Q_SPOTIFY, SYNTHETIC_TABLES, self.backend, k=10)
+        self.assertEqual(len(ranked_big), len(SYNTHETIC_TABLES))
+
+        # il default di k è 3
+        ranked_default = table_router.route(Q_SPOTIFY, SYNTHETIC_TABLES, self.backend)
+        self.assertEqual(len(ranked_default), 3)
+
+        # forma: lista di (name: str, score: float)
+        name, score = ranked3[0]
+        self.assertIsInstance(name, str)
+        self.assertIsInstance(score, float)
+
+    def test_obviously_matching_table_ranks_first(self) -> None:
+        ranked = table_router.route(Q_SPOTIFY, SYNTHETIC_TABLES, self.backend, k=len(SYNTHETIC_TABLES))
+        self.assertEqual(ranked[0][0], "spotify_plays")
+        # la corrispondenza deve dare un punteggio reale (> 0), non solo ordine stabile
+        self.assertGreater(ranked[0][1], 0.0)
+
+    def test_another_obviously_matching_table_ranks_first(self) -> None:
+        ranked = table_router.route(Q_CHESS, SYNTHETIC_TABLES, self.backend, k=len(SYNTHETIC_TABLES))
+        self.assertEqual(ranked[0][0], "chess_games")
+        self.assertGreater(ranked[0][1], 0.0)
+
+    def test_no_matching_tokens_is_graceful(self) -> None:
+        gibberish = "zzzqqq www vvv"
+        ranked = table_router.route(gibberish, SYNTHETIC_TABLES, self.backend, k=3)
+        self.assertEqual(len(ranked), 3)
+        for _name, score in ranked:
+            self.assertEqual(score, 0.0)
+
+    def test_shuffling_table_order_does_not_crash(self) -> None:
+        # 25 shuffli: nessuna eccezione, lunghezza stabile, e la tabella migliore
+        # resta prima (proprietà di robustezza attesa: ranking indipendente dall'ordine).
+        for _ in range(25):
+            shuffled = [dict(t) for t in SYNTHETIC_TABLES]
+            random.shuffle(shuffled)
+            ranked = self.backend.rank(Q_SPOTIFY, shuffled)
+            self.assertEqual(len(ranked), len(SYNTHETIC_TABLES))
+            self.assertEqual(ranked[0][0], "spotify_plays")
+
+    def test_shuffle_tables_evaluate_returns_metric_keys(self) -> None:
+        cases = [
+            {"question": Q_SPOTIFY, "needed_tables": ["spotify_plays"]},
+            {"question": Q_CHESS, "needed_tables": ["chess_games"]},
+        ]
+        result = table_router.shuffle_tables_evaluate(
+            self.backend, cases, SYNTHETIC_TABLES, k=3, n_shuffles=5
+        )
+        expected_keys = {
+            "top1_mean", "top1_std",
+            "top3_mean", "top3_std",
+            "recall_at_k_mean", "recall_at_k_std",
+        }
+        self.assertEqual(set(result.keys()), expected_keys)
+        for value in result.values():
+            self.assertIsInstance(value, float)
+            self.assertGreaterEqual(value, 0.0)
+            self.assertLessEqual(value, 1.0)
+
+    def test_evaluate_returns_expected_metrics(self) -> None:
+        cases = [
+            {"question": Q_SPOTIFY, "needed_tables": ["spotify_plays"]},
+            {"question": Q_CHESS, "needed_tables": ["chess_games"]},
+        ]
+        metrics = table_router.evaluate(self.backend, cases, SYNTHETIC_TABLES, k=3)
+        self.assertEqual(set(metrics.keys()), {"top1", "top3", "recall_at_k"})
+        self.assertEqual(metrics["top1"], 1.0)
+        self.assertEqual(metrics["top3"], 1.0)
+        self.assertEqual(metrics["recall_at_k"], 1.0)
+
+
+class PrivacyPolicyTests(unittest.TestCase):
+    def test_default_policy_is_l0(self) -> None:
+        policy = privacy_policy.load_policy({})
+        self.assertEqual(policy.level, privacy_policy.Policy.L0)
+
+    def test_l0_blocks_everything(self) -> None:
+        p0 = privacy_policy.Policy(privacy_policy.Policy.L0)
+        self.assertFalse(p0.allows("question"))
+        self.assertFalse(p0.allows("table_descriptions"))
+        self.assertFalse(p0.allows("query_results"))
+
+    def test_missing_section_gives_l0(self) -> None:
+        policy = privacy_policy.load_policy({"some_other_section": {"x": 1}})
+        self.assertEqual(policy.level, privacy_policy.Policy.L0)
+
+    def test_missing_level_gives_l0(self) -> None:
+        policy = privacy_policy.load_policy(
+            {"privacy": {"per_domain_overrides": {"spotify": 2}}}
+        )
+        self.assertEqual(policy.level, privacy_policy.Policy.L0)
+
+    def test_l1_blocks_query_results(self) -> None:
+        p1 = privacy_policy.Policy(privacy_policy.Policy.L1)
+        self.assertTrue(p1.allows("question"))
+        self.assertTrue(p1.allows("table_descriptions"))
+        self.assertFalse(p1.allows("query_results"))
+
+    def test_l2_allows_query_results(self) -> None:
+        p2 = privacy_policy.Policy(privacy_policy.Policy.L2)
+        self.assertTrue(p2.allows("query_results"))
+
+    def test_l2_redacts_sensitive_columns(self) -> None:
+        p2 = privacy_policy.Policy(privacy_policy.Policy.L2)
+        columns = [
+            {"name": "user_id", "sensitive": True},
+            {"name": "track_name", "sensitive": False},
+            {"name": "email", "sensitive": True},
+        ]
+        rows = [
+            {"user_id": "u1", "track_name": "Song", "email": "a@b.c"},
+            {"user_id": "u2", "track_name": "Song2", "email": "d@e.f"},
+        ]
+        redacted = p2.redact_rows(columns, rows)
+        self.assertEqual(redacted, [
+            {"user_id": "[omesso]", "track_name": "Song", "email": "[omesso]"},
+            {"user_id": "[omesso]", "track_name": "Song2", "email": "[omesso]"},
+        ])
+        # le righe in ingresso non devono essere modificate
+        self.assertEqual(rows[0]["user_id"], "u1")
+        self.assertEqual(rows[0]["email"], "a@b.c")
+
+    def test_load_policy_valid_config(self) -> None:
+        p = privacy_policy.load_policy(
+            {"privacy": {"level": 2, "per_domain_overrides": {"money": 0}}}
+        )
+        self.assertEqual(p.level, privacy_policy.Policy.L2)
+        self.assertEqual(p.per_domain_overrides, {"money": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
