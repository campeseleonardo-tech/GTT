+def _nome_file_sicuro(nome):
+    # Sostituisce i caratteri non ammessi nei nomi file con underscore
+    import re
+    # Caratteri non ammessi: < > : " / \ | ? * e caratteri di controllo (0-31, 127)
+    nome = re.sub(r'[<>:\\"/|?*\x00-\x1f\x7f]', '_', nome)
+    # Se il nome risultante è vuoto, usiamo "preventivo"
+    if not nome:
+        nome = "preventivo"
+    return nome
