+# -*- coding: utf-8 -*-
+"""
+prova_finta.py - Script di test per genera_preventivo.py (solo libreria standard).
+Esegue la generazione del preventivo usando i dati di prova finto_01.json
+all'interno di una cartella temporanea ed effettua 5 verifiche di integrità:
+  (a) Il file .docx generato è apribile come archivio zip valido.
+  (b) Nessun segnaposto '[[' è rimasto in word/document.xml.
+  (c) Tutti i valori del JSON compaiono nel documento.
+  (d) I file immagine in word/media/* sono identici byte per byte a quelli del modello.
+  (e) Se ci sono voci con importi e un totale, la somma delle voci corrisponde al totale.
+
+Uso:
+  python strumenti/prova_finta.py
+  (oppure da dentro strumenti/: python prova_finta.py)
+"""
+import json
+import re
+import subprocess
+import sys
+import tempfile
+import zipfile
+from decimal import Decimal
+from pathlib import Path
+
+
+def _un(s):
+    """Converte entità XML nei rispettivi caratteri normali."""
+    return s.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", '"').replace("&apos;", "'").replace("&amp;", "&")
+
+
+def estrai_importo_voce(voce_str):
+    """Estrae l'importo decimale da una singola voce di preventivo."""
+    # Cerca importo preceduto dal simbolo euro (es. '€ 650,00' o '€ 1.100,00')
+    m = re.search(r"€\s*([0-9]{1,3}(?:\.[0-9]{3})*(?:,[0-9]{1,2})?)", voce_str)
+    if not m:
+        # Alternativa: importo alla fine della riga dopo trattino
+        m = re.search(r"[-–]\s*€?\s*([0-9]{1,3}(?:\.[0-9]{3})*(?:,[0-9]{1,2})?)\s*$", voce_str)
+    if not m:
+        # Cerca l'ultimo numero con formato importo presente nella voce
+        tutti = re.findall(r"([0-9]{1,3}(?:\.[0-9]{3})*(?:,[0-9]{1,2})|[0-9]+(?:,[0-9]{1,2}))", voce_str)
+        if tutti:
+            num_str = tutti[-1]
+            pulito = num_str.replace(".", "").replace(",", ".")
+            return Decimal(pulito)
+        return None
+    num_str = m.group(1)
+    if "," not in num_str and "." not in num_str:
+        pulito = num_str + ".00"
+    else:
+        pulito = num_str.replace(".", "").replace(",", ".")
+    return Decimal(pulito)
+
+
+def estrai_totale(tot_val):
+    """Estrae l'importo decimale dal valore del TOTALE."""
+    s = str(tot_val).replace("€", "").strip()
+    m = re.search(r"([0-9]{1,3}(?:\.[0-9]{3})*(?:,[0-9]{1,2})|[0-9]+(?:,[0-9]{1,2})?)", s)
+    if not m:
+        return None
+    num_str = m.group(1)
+    if "," not in num_str and "." not in num_str:
+        pulito = num_str + ".00"
+    else:
+        pulito = num_str.replace(".", "").replace(",", ".")
+    return Decimal(pulito)
+
+
+def esegui_test(json_path=None):
+    here = Path(__file__).resolve().parent
+    repo_root = here.parent if (here.parent / "Preventivo Automatico").is_dir() else Path.cwd()
+
+    genera_py = here / "genera_preventivo.py"
+    if not genera_py.is_file():
+        genera_py = repo_root / "strumenti" / "genera_preventivo.py"
+
+    if json_path is None:
+        json_path = here / "esempi" / "finto_01.json"
+        if not json_path.is_file():
+            json_path = repo_root / "strumenti" / "esempi" / "finto_01.json"
+
+    modello_path = repo_root / "Preventivo Automatico" / "MOD_PREVENTIVO_v4_1.docx"
+
+    # Verifiche preliminari sui percorsi
+    if not genera_py.is_file():
+        print(f"ERRORE: genera_preventivo.py non trovato in {genera_py}", file=sys.stderr)
+        return False
+    if not json_path.is_file():
+        print(f"ERRORE: file JSON non trovato in {json_path}", file=sys.stderr)
+        return False
+    if not modello_path.is_file():
+        print(f"ERRORE: modello Word non trovato in {modello_path}", file=sys.stderr)
+        return False
+
+    with open(json_path, "r", encoding="utf-8") as f:
+        dati = json.load(f)
+
+    problemi = []
+
+    with tempfile.TemporaryDirectory() as tmpdir:
+        temp_dir = Path(tmpdir)
+
+        # Esecuzione del generatore dentro la cartella temporanea
+        cmd = [sys.executable, str(genera_py), str(json_path), str(temp_dir), str(modello_path)]
+        risultato = subprocess.run(cmd, capture_output=True, text=True)
+
+        if risultato.returncode != 0:
+            problemi.append(
+                f"Esecuzione genera_preventivo.py fallita (codice {risultato.returncode}).\n"
+                f"STDOUT: {risultato.stdout}\nSTDERR: {risultato.stderr}"
+            )
+            print("\n".join(problemi))
+            return False
+
+        file_generati = list(temp_dir.glob("*.docx"))
+        if not file_generati:
+            problemi.append("Nessun file .docx trovato nella cartella temporanea di output.")
+            print("\n".join(problemi))
+            return False
+
+        docx_path = file_generati[0]
+
+        # (a) Verifica che il file si apra come archivio zip valido
+        is_zip = False
+        try:
+            with zipfile.ZipFile(docx_path, "r") as z:
+                corrotto = z.testzip()
+                if corrotto:
+                    problemi.append(f"(a) Il file .docx generato ha un archivio zip corrotto (file: {corrotto}).")
+                else:
+                    is_zip = True
+                    print("[OK] (a) Il file .docx si apre correttamente come archivio zip integro.")
+        except Exception as e:
+            problemi.append(f"(a) Impossibile aprire il file generato come archivio zip: {e}")
+
+        if not is_zip:
+            print("\nProblemi riscontrati:")
+            for p in problemi:
+                print(f"  - {p}")
+            return False
+
+        # (b) Nessun segnaposto '[[' rimasto in word/document.xml
+        doc_xml = ""
+        try:
+            with zipfile.ZipFile(docx_path, "r") as z:
+                doc_xml = z.read("word/document.xml").decode("utf-8")
+                rimasti = re.findall(r"\[\[.*?\]\]", doc_xml)
+                if rimasti or "[[" in doc_xml:
+                    elenco = ", ".join(repr(r) for r in rimasti) if rimasti else "[["
+                    problemi.append(f"(b) Segnaposti '[[' non sostituiti in word/document.xml: {elenco}")
+                else:
+                    print("[OK] (b) Nessun segnaposto '[[' presente in word/document.xml.")
+        except Exception as e:
+            problemi.append(f"(b) Errore nella lettura di word/document.xml: {e}")
+
+        # (c) Tutti i valori del JSON compaiono nel documento
+        if doc_xml:
+            unescaped_xml = _un(doc_xml)
+            pezzi_testo = re.findall(r"<w:t(?: [^>]*)?>(.*?)</w:t>", doc_xml, re.S)
+            testo_concatenato = _un("".join(pezzi_testo))
+
+            valori_mancanti = []
+            for chiave, valore in dati.items():
+                if chiave == "VOCI":
+                    for idx, v in enumerate(valore, 1):
+                        v_str = str(v)
+                        if v_str not in unescaped_xml and v_str not in testo_concatenato:
+                            valori_mancanti.append(f"VOCI[{idx}]: {v_str}")
+                elif isinstance(valore, str):
+                    v_str = valore.strip()
+                    if v_str and (v_str not in unescaped_xml and v_str not in testo_concatenato):
+                        valori_mancanti.append(f"{chiave}: {v_str}")
+
+            if valori_mancanti:
+                dettagli = "\n    " + "\n    ".join(valori_mancanti)
+                problemi.append(f"(c) Valori del JSON non trovati nel testo del documento:{dettagli}")
+            else:
+                print("[OK] (c) Tutti i valori del JSON compaiono nel documento generato.")
+
+        # (d) I file immagine dell'intestazione (word/media/*) sono byte-identici al modello
+        try:
+            with zipfile.ZipFile(modello_path, "r") as z_mod, zipfile.ZipFile(docx_path, "r") as z_out:
+                mod_media = {n: z_mod.read(n) for n in z_mod.namelist() if n.startswith("word/media/") and not n.endswith("/")}
+                out_media = {n: z_out.read(n) for n in z_out.namelist() if n.startswith("word/media/") and not n.endswith("/")}
+
+                if not mod_media:
+                    problemi.append("(d) Nessuna immagine trovata in word/media/ nel modello di partenza.")
+                else:
+                    diffs = []
+                    for nome_img, dati_mod in mod_media.items():
+                        if nome_img not in out_media:
+                            diffs.append(f"Immagine mancante nell'output: {nome_img}")
+                        elif out_media[nome_img] != dati_mod:
+                            diffs.append(
+                                f"Immagine modificata byte per byte: {nome_img} "
+                                f"(modello: {len(dati_mod)} byte, generato: {len(out_media[nome_img])} byte)"
+                            )
+
+                    for nome_img in out_media:
+                        if nome_img not in mod_media:
+                            diffs.append(f"Immagine imprevista presente solo nell'output: {nome_img}")
+
+                    if diffs:
+                        dettagli = "\n    " + "\n    ".join(diffs)
+                        problemi.append(f"(d) Differenze riscontrate nei file immagine (word/media/*):{dettagli}")
+                    else:
+                        nomi_img = ", ".join(sorted(mod_media.keys()))
+                        print(f"[OK] (d) File immagine ({nomi_img}) byte-identici a quelli del modello.")
+        except Exception as e:
+            problemi.append(f"(d) Errore nel confronto delle immagini word/media/*: {e}")
+
+        # (e) Somma delle voci corrisponde al TOTALE
+        voci = dati.get("VOCI")
+        totale_val = dati.get("TOTALE")
+        if voci and totale_val is not None:
+            totale_atteso = estrai_totale(totale_val)
+            if totale_atteso is None:
+                problemi.append(f"(e) Impossibile estrarre un valore numerico da TOTALE: {totale_val!r}")
+            else:
+                somma_voci = Decimal("0.00")
+                errore_voce = False
+                for idx, riga_voce in enumerate(voci, 1):
+                    imp = estrai_importo_voce(str(riga_voce))
+                    if imp is None:
+                        problemi.append(f"(e) Impossibile estrarre l'importo dalla voce {idx}: {riga_voce!r}")
+                        errore_voce = True
+                    else:
+                        somma_voci += imp
+
+                if not errore_voce:
+                    if somma_voci == totale_atteso:
+                        print(f"[OK] (e) Somma delle {len(voci)} voci ({somma_voci:.2f} €) coincide con TOTALE ({totale_atteso:.2f} €).")
+                    else:
+                        problemi.append(
+                            f"(e) Discrepanza aritmetica: somma voci = {somma_voci:.2f} €, "
+                            f"mentre TOTALE = {totale_atteso:.2f} € (differenza: {somma_voci - totale_atteso:.2f} €)."
+                        )
+
+    if problemi:
+        print("\nPROBLEMI RISCONTRATI:")
+        for p in problemi:
+            print(f"  - {p}")
+        return False
+
+    print("\nOK")
+    return True
+
+
+if __name__ == "__main__":
+    file_input = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
+    successo = esegui_test(file_input)
+    sys.exit(0 if successo else 1)
